<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pinky_soccer_vision</name>
  <version>0.1.0</version>
  <description>Golf-ball perception: HSV baseline, YOLO detector, auto-labelled dataset collector, trainer</description>
  <maintainer email="user@example.com">pinky-soccer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <depend>pinky_soccer_sim</depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
