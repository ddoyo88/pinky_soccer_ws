<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pinky_soccer_sim</name>
  <version>0.1.0</version>
  <description>Parametric soccer field (Gazebo SDF + occupancy map generator), ros_gz bridges, sim launch</description>
  <maintainer email="user@example.com">pinky-soccer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_image</depend>
  <depend>joint_state_publisher</depend>
  <depend>pinky_description</depend>
  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>
  <depend>pinky_soccer_description</depend>
  <exec_depend>robot_localization</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
