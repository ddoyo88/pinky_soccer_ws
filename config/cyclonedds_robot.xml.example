<!-- ON THE ROBOT: ~/cyclonedds.xml.  Multicast is often blocked on shared Wi-Fi, so the PC is listed as a peer.
     Replace PC_IP with the PC's address (ip -4 addr on the PC). -->
<CycloneDDS>
  <Domain>
    <General>
      <Interfaces>
        <NetworkInterface name="wlan0"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <Peers>
        <Peer Address="localhost"/>
        <Peer Address="PC_IP"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
